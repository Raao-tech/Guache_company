server {
    listen 80;
    server_name tu_ip_publica_o_dominio.com;

    # Opcional pero recomendado para producción: 
    # Dejar que Nginx sirva los estáticos directamente (es más rápido)
    location /styles.css {
        alias /var/www/agroguache/web/styles.css;
    }
    location /app.js {
        alias /var/www/agroguache/web/app.js;
    }

    # Redirigir el resto del tráfico a FastAPI (Puerto 8000)
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}