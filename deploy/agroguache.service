[Unit]
Description=Backend de Agroindustria Guache (FastAPI)
After=network.target

[Service]
User=root
# Ajustaremos esta ruta al directorio real en el VPS
WorkingDirectory=/var/www/agroguache
EnvironmentFile=/var/www/agroguache/.env

# Ejecuta uvicorn desde el entorno virtual del VPS
ExecStart=/var/www/agroguache/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target