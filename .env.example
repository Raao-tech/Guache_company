# Configuración del Bot de Telegram
TELEGRAM_BOT_TOKEN="Tu_clave_bot_aqui"

# Claves de modelos de lenguaje (las añadiremos en el siguiente paso)
GROQ_API_KEY="sk-proj-tu-clave-aqui"
# ANTHROPIC_API_KEY="tu-clave-de-claude"

# Credenciales de administración — protegen GET /api/cotizaciones (HTTP Basic Auth)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambia-esta-clave-por-una-segura"

# Orígenes permitidos para CORS, separados por coma (sin espacios extra necesarios)
# En desarrollo: localhost. En producción (VPS): https://guache.online,https://www.guache.online
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# Base de datos: si no se define, usa SQLite local (./cotizaciones.db) — ideal para desarrollo.
# En producción (VPS), apuntar a Postgres:
# DATABASE_URL="postgresql+psycopg://usuario:clave@localhost:5432/agroguache"

# Ajustes generales de la aplicación
ENVIRONMENT="development"
PORT=8000